@model UpdateInternshipOpeningRequest

@{
    ViewData["Title"] = "Edit";
}

<section class="form-card">
    <div class="section-header">
        <div>
            <p class="eyebrow">Update Opening</p>
            <h1>Edit Internship</h1>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@ViewBag.InternshipId" method="post" class="portal-form">
        <div asp-validation-summary="ModelOnly" class="validation-box"></div>

        <label>
            <span>Title</span>
            <input asp-for="Title" />
        </label>

        <label>
            <span>Description</span>
            <textarea asp-for="Description" rows="4"></textarea>
        </label>

        <div class="form-grid">
            <label>
                <span>Company</span>
                <input asp-for="CompanyName" />
            </label>
            <label>
                <span>Location</span>
                <input asp-for="Location" />
            </label>
            <label>
                <span>Duration</span>
                <input asp-for="Duration" />
            </label>
            <label>
                <span>Stipend</span>
                <input asp-for="Stipend" type="number" step="0.01" />
            </label>
            <label>
                <span>Last Date</span>
                <input asp-for="LastDate" type="date" />
            </label>
            <label class="checkbox-row">
                <input asp-for="IsActive" type="checkbox" />
                <span>Keep this internship active</span>
            </label>
        </div>

        <div class="page-actions">
            <button type="submit" class="button button-primary">Update</button>
            <a asp-action="Index" class="button button-secondary">Cancel</a>
        </div>
    </form>
</section>